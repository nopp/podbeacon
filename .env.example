# Key from https://console.x.ai/team/default/api-keys
XAI_API_KEY=
XAI_MODEL=grok-4.7
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_TIMEOUT=180s

# One Slack mode. The webhook is the short path.
SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=C0123456789

# Empty lists every namespace except the excluded ones.
# NAMESPACES=prod,payments
# An explicit empty EXCLUDE_NAMESPACES excludes nothing, including kube-system.
# EXCLUDE_NAMESPACES=kube-system,kube-public,kube-node-lease

# POLL_INTERVAL=1m
# ALERT_COOLDOWN=30m
# STARTUP_GRACE=2m
# LOG_TAIL_LINES=80
# MAX_LOG_BYTES=12000
# MAX_ALERTS_PER_SCAN=8

# DRY_RUN=true prints the message and does not call Slack.
# ONCE=true runs one scan and exits.
